# ── Fabricate Forge API Config ──────────────────────────
# Copy to .env and fill in real values.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=fabricate_forge
DB_USER=forge
DB_PASS=

# Path to the shared forge framework (used by _base.php)
FORGE_PATH=/var/www/html/forge

# Auth secret for forge\api\Auth sessions
AUTH_SECRET=change-me
